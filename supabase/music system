-- SOT TOK Original Sound System
create table if not exists sounds (
  id uuid primary key default gen_random_uuid(),
  title text not null,
  file_url text not null,
  cover_url text,
  uploaded_by uuid references auth.users(id),
  duration int default 15,
  use_count int default 0,
  created_at timestamp default now()
);

-- Make videos public
alter table videos add column if not exists sound_id uuid references sounds(id);
alter table videos add column if not exists is_private boolean default false;

-- Public Read Policy - সবার ভিডিও সবাই দেখবে
drop policy if exists "public read videos" on videos;
create policy "public read videos" on videos for select using (is_private = false or is_private is null);

drop policy if exists "public read sounds" on sounds;
create policy "public read sounds" on sounds for select using (true);
alter table sounds enable row level security;
alter table videos enable row level security;

